[[Node]] start
[action] output(get_var_or(@hello, 1.0))
[set] @hello "Hello, World!"
[action] output(get_var_or(@hello, "Oh No"))
[random]
- [jump] one
- [jump] two

[[Node]] one
[set] @yes 6
[jump] two

[[Node]] two
[match] @yes
- [4] [action] output("No WAY")
- [6] [action] output("Ofcourse")
[jump] end

[[Node]] end